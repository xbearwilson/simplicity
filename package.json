{
	"name": "simplicity",
	"description": "簡實新村 (Simplicity & Honesty) - 新店村老麵饅頭官方網站。提供道地老麵饅頭，堅持天然食材，無添加人工香料。",
	"keywords": [
		"簡實新村",
		"老麵饅頭",
		"新店美食",
		"手工饅頭",
		"Simplicity & Honesty",
		"Mantou",
		"Taiwanese Food"
	],
	"author": "簡實新村 Simplicity & Honesty",
	"homepage": "https://simplicity-coral.vercel.app/",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"d": "vite --host --open",
		"build": "node scripts/audit-watermarks.mjs --counts-only && node scripts/clean-dist.mjs && vite build && node scripts/generate-static.mjs",
		"b": "pnpm run build",
		"watermark": "node scripts/apply-watermark.mjs",
		"watermark:audit": "node scripts/audit-watermarks.mjs",
		"watermark:check": "node scripts/audit-watermarks.mjs --counts-only",
		"watermark:mark-verified": "node scripts/mark-verified-watermark.mjs",
		"v": "node scripts/verify-static.mjs",
		"p": "pnpm run build && vite preview --open"
	},
	"dependencies": {
		"lenis": "^1.3.27",
		"lodash": "^4.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-lazy-load-image-component": "^1.6.3",
		"update-browserslist-db": "^1.3.4"
	},
	"devDependencies": {
		"@csstools/postcss-bundler": "^1.0.15",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.6.2",
		"cssnano": "^7.1.9",
		"glob": "14.0.3",
		"postcss": "^8.5.32",
		"postcss-combine-duplicated-selectors": "^10.0.3",
		"postcss-easings": "^4.0.0",
		"postcss-import": "^16.2.0",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^10.6.1",
		"postcss-sort-media-queries": "^5.2.0",
		"pug": "^3.0.4",
		"sass": "^1.107.1",
		"sharp": "0.35.5",
		"vite": "^7.3.7",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-glsl": "^1.6.2",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-image-optimizer": "^1.1.9",
		"vite-plugin-inspect": "^11.4.1"
	},
	"engines": {
		"node": "22.x"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
